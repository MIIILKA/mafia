# Адреса сервера (Node.js + Socket.IO)
VITE_SERVER_URL=http://localhost:4000

# TURN-сервер (опційно, для надійнішого відео між різними мережами).
# Безкоштовний варіант: зареєструйтесь на https://www.metered.ca/tools/openrelay/
# (або будь-якому іншому TURN-провайдері з безплатним тарифом) і вставте свої дані сюди.
# Якщо залишити порожнім — використовується лише публічний STUN (Google),
# цього зазвичай достатньо для гри з друзями в звичайних домашніх мережах.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
